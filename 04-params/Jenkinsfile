pipeline{
    agent any

    parameters{
        choice (
            name: 'ENV',
            choices: ['prod' ,'uat' , 'test', 'dev'],
            description: 'select the deploying environment'
        )
    }

    stages{
        stage('selcting with env'){
            steps{
                echo "Deploying to ${params.ENV} env"

            // adding logic
            script{
                switch(params.ENV) {
                    case 'prod':
                    echo "Running in prod"
                    break

                    case 'uat':
                    echo "Running in uat"
                    break

                    case 'test':
                    echo "Running in test"
                    break

                    case 'dev':
                    echo "Running in dev"
                    break

                    default:
                    echo "invalid env selected"
                }

            }






            }
        }
    }
}